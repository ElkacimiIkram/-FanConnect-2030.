# FanConnect 2030 - Environment Variables

# Database
DB_HOST=localhost
# 5433 évite le conflit avec un PostgreSQL local/XAMPP sur 5432
DB_PORT=5433
DB_NAME=fanconnect
DB_USER=fanconnect
DB_PASSWORD=fanconnect_secret

# Backend
SERVER_PORT=9090

# Match Center — données live (gratuit sur https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
JWT_SECRET=Y2hhbmdlLXRoaXMtc2VjcmV0LWluLXByb2R1Y3Rpb24tbWluLTI1Ni1iaXRz
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:5173

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
PAYMENT_MODE=stripe

# Frontend (copier aussi dans frontend/.env pour Vite)
VITE_API_BASE_URL=/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# FanBot (Grok / SpaceXAI) — optionnel. Sans clé, le chatbot utilise le fallback local.
XAI_API_KEY=
XAI_MODEL=grok-4.5